APP_ENV=local
# Copie para .env na raiz e preencha apenas neste arquivo local.
# API_TOKEN é a chave da OpenAI, nunca uma configuração do Angular.
API_TOKEN=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_OUTPUT_TOKENS=32768
# Endpoint corporativo opcional, compatível com a Responses API.
OPENAI_BASE_URL=
# Apenas para gateway autenticado em homologação/produção.
GATEWAY_TOKEN=

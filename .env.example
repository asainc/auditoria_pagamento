APP_ENV=local
# Copie para .env na raiz. Não versione credenciais ou tokens reais.

# Ambiente corporativo habilitado: dev, homol ou prod.
BRADESCO_IAGEN_AMBIENTE=dev

# Autenticação do gpt_bradesco.py distribuído neste projeto. Configure UMA das opções:
# 1) BRADESCO_AUTHORIZATION_TOKEN; ou
# 2) BRADESCO_IDENTIFICADOR + BRADESCO_SENHA.
# Nunca versione valores reais. Se sua organização substituir este módulo por uma versão
# corporativa que autentica internamente, siga o contrato oficial dessa versão.
BRADESCO_AUTHORIZATION_TOKEN=
BRADESCO_IDENTIFICADOR=
BRADESCO_SENHA=

# TLS: por padrão, deixe vazio. A aplicação usa o repositório de certificados
# confiáveis do sistema operacional (no Windows, o Windows Certificate Store).
# Preencha SOMENTE se a equipe de infraestrutura fornecer um bundle PEM de CA
# específico para esta integração. Nunca use verify=False.
BRADESCO_CA_BUNDLE=
BRADESCO_TIMEOUT_SECONDS=600

# Deployment corporativo de geração de texto.
BRADESCO_TEXT_MODEL=gpt-5.1
BRADESCO_TEXT_TEMPERATURE=1
BRADESCO_TEXT_MAX_TOKENS=16384
BRADESCO_PROMPT_MAX_CHARS=55000
EXTRACTION_MAX_PAGES_PER_TASK=16
EXTRACTION_FALLBACK_PAGES_PER_DOCUMENT=4
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_DELAY_SECONDS=5
EXTRACTION_LEASE_SECONDS=900

# Os PDFs são lidos localmente com PyMuPDF. Não há configuração de OCR ou container.

# Apenas para gateway autenticado em homologação/produção da calculadora.
GATEWAY_TOKEN=

# Opcionais: URLs HTTPS completas, somente se confirmadas pela equipe da API.
# Valores vazios mantêm as rotas existentes do módulo corporativo.
BRADESCO_TEXT_URL=
BRADESCO_IDENTITY_URL=

# FinOps de IA. Os limites abaixo reduzem custo e impedem payloads inesperadamente grandes.
# A tarifa deve ser preenchida SOMENTE com valores oficiais/verificados da API corporativa.
AI_FINOPS_CACHE_ENABLED=true
AI_FINOPS_CACHE_TTL_DAYS=30
AI_FINOPS_MAX_CALLS_PER_JOB=60
AI_FINOPS_MAX_INPUT_CHARS_PER_JOB=1500000
AI_FINOPS_INPUT_USD_PER_MILLION_TOKENS=
AI_FINOPS_OUTPUT_USD_PER_MILLION_TOKENS=
AI_FINOPS_CACHED_INPUT_USD_PER_MILLION_TOKENS=
AI_FINOPS_MONTHLY_BUDGET_USD=
AI_FINOPS_BUDGET_WARNING_RATIO=0.80
# Habilite o bloqueio somente depois de validar tarifas e telemetria no ambiente corporativo.
AI_FINOPS_ENFORCE_MONTHLY_BUDGET=false

# Aprendizado supervisionado por exemplos aprovados. Não há aprendizado online automático.
LEARNING_EXAMPLES_ENABLED=true
LEARNING_MAX_EXAMPLES_PER_TASK=3
LEARNING_MAX_CHARS_PER_TASK=1800

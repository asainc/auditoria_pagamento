APP_ENV=local
# Copie para .env na raiz. Não versione credenciais ou tokens reais.

# Ambiente corporativo habilitado: dev, homol ou prod.
BRADESCO_IAGEN_AMBIENTE=dev

# Autenticação: use token emitido OU identificador + senha, conforme o fluxo aprovado.
BRADESCO_AUTHORIZATION_TOKEN=
BRADESCO_IDENTIFICADOR=
BRADESCO_SENHA=

# Caminho opcional para a CA corporativa quando o ambiente exigir certificado interno.
BRADESCO_CA_BUNDLE=
BRADESCO_TIMEOUT_SECONDS=600

# Deployment corporativo de geração de texto.
BRADESCO_TEXT_MODEL=gpt-5.1
BRADESCO_TEXT_REASONING_EFFORT=medium
BRADESCO_TEXT_VERBOSITY=medium
BRADESCO_TEXT_TEMPERATURE=1
BRADESCO_TEXT_MAX_TOKENS=16384
BRADESCO_PROMPT_MAX_CHARS=55000

# OCR híbrido corporativo. Informe um container autorizado para o projeto.
BRADESCO_OCR_CONTAINER=
BRADESCO_OCR_CREATE_CONTAINER=false
BRADESCO_OCR_WORKFLOW=CD_WRFL_OCR_HYBRID_ASYNC
BRADESCO_OCR_VISION_MODEL=gpt-4o
BRADESCO_OCR_LANGUAGE_MODEL=gpt-4o
BRADESCO_OCR_LOCALE=pt-BR
BRADESCO_OCR_POLL_INTERVAL_SECONDS=5
BRADESCO_OCR_MAX_WAIT_SECONDS=600

# Apenas para gateway autenticado em homologação/produção da calculadora.
GATEWAY_TOKEN=

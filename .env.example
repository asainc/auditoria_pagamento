APP_ENV=local
# Copie para .env na raiz. Não versione credenciais ou tokens reais.

# Ambiente corporativo habilitado: dev, homol ou prod.
BRADESCO_IAGEN_AMBIENTE=dev

# Autenticação opcional da calculadora: preencha apenas se a sua versão de gpt_bradesco.py expuser configure_iagen.
# Versões legadas que autenticam internamente podem manter estes campos vazios.
BRADESCO_AUTHORIZATION_TOKEN=
BRADESCO_IDENTIFICADOR=
BRADESCO_SENHA=

# Caminho opcional para a CA corporativa quando o ambiente exigir certificado interno.
BRADESCO_CA_BUNDLE=
BRADESCO_TIMEOUT_SECONDS=600

# Deployment corporativo de geração de texto.
BRADESCO_TEXT_MODEL=gpt-5.1
BRADESCO_TEXT_TEMPERATURE=1
BRADESCO_TEXT_MAX_TOKENS=16384
BRADESCO_PROMPT_MAX_CHARS=55000
EXTRACTION_MAX_PAGES_PER_TASK=16
EXTRACTION_FALLBACK_PAGES_PER_DOCUMENT=4
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_DELAY_SECONDS=5
EXTRACTION_LEASE_SECONDS=900

# Os PDFs são lidos localmente com PyMuPDF. Não há configuração de OCR ou container.

# Apenas para gateway autenticado em homologação/produção da calculadora.
GATEWAY_TOKEN=
